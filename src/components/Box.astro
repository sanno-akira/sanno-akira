
---
/**
 * Box — 引用ではない囲みコンテンツ用
 *
 * 用途: 年表、あらすじ要約、人物リストなど
 *       blockquote（引用）と区別するためのコンポーネント
 *
 * 使い方（MDX内）:
 *   import Box from '../../components/Box.astro';
 *
 *   <Box>
 *     ここに年表やあらすじなどを書く。
 *     Markdown記法もそのまま使えます。
 *   </Box>
 */
---
 
<aside class="box" role="note">
  <slot />
</aside>
 
<style>
  .box {
    border-left: 3px solid #c0c8d4;
    padding-left: 1.2em;
    margin: 1.6rem 0;
    font-size: 0.92em;
    color: #1a1a1a;
    line-height: 2;
  }
  .box :global(ul) {
    list-style: none;
    padding-left: 0;
  }
  .box :global(ul li)::before {
    content: '·';
    margin-right: 0.5em;
    color: #1a1a1a;
  }
  .box :global(p + ul) {
  margin-top: -0.5em;
  }
  .box :global(p) {
  margin-bottom: 0.3em;
  }
</style>
