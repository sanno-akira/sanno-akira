---
/**
 * BaseLayout — 全ページ共通のHTMLシェル（トップページ以外）
 *
 * 使い方:
 *   ---
 *   import BaseLayout from '../../layouts/BaseLayout.astro';
 *   ---
 *   <BaseLayout title="ページタイトル">
 *     <p>ここにページ固有のHTMLを書く</p>
 *   </BaseLayout>
 *
 * やっていること:
 *   - <!DOCTYPE html> 〜 </html> を提供
 *   - Google Fonts の読み込み（1回だけ）
 *   - リセットCSS（* { box-sizing ... }）
 *   - body の基本フォント設定
 *   - <slot /> で中身を差し込む
 */
interface Props {
  title: string;
  lang?: string;
}
const { title, lang = 'ja' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
  <!-- ページ固有の<head>内容を差し込むスロット -->
  <slot name="head" />
  <style is:global>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Noto Sans JP', sans-serif;
      background: #fff;
      color: #1a1a1a;
    }
  </style>
</head>
<body>
  <!-- ページの中身がここに入る -->
  <slot />
</body>
</html>
