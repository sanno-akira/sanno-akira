---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import topImage from '../assets/Sanno-top.jpg';

const allPosts = await getCollection('column');
const news = allPosts
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 10);
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>山王晶</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@400;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Noto Sans JP', sans-serif; background: #fff; color: #1a1a1a; }
    .top-layout { display: grid; grid-template-columns: 2fr 3fr; align-items: stretch; }
    .top-image { overflow: hidden; }
    .top-image img { width: 100%; height: 100%; object-fit: cover; object-position: center bottom; display: block; }
    .top-right { display: flex; flex-direction: column; background: #fff; }
    .top-name { display: flex; flex-direction: column; justify-content: flex-start; padding: 40px 48px 0; text-align: center; }
    .site-title { font-family: 'Noto Serif JP', serif; font-size: 120px; font-weight: 700; line-height: 1; color: #1a1a1a; text-align: justify; text-align-last: justify; width: 100%; letter-spacing: 0; }
    .site-title-en { font-family: 'Noto Serif JP', serif; font-size: 16px; margin-top: 12px; color: #1a1a1a; text-align: justify; text-align-last: justify; width: 100%; padding-bottom: 20px; border-bottom: 0.5px solid #ccc; }
    .header-nav { display: flex; align-items: center; gap: 20px; padding: 12px 48px; justify-content: flex-end; }
    .header-nav a { color: #1a1a1a; text-decoration: none; font-size: 12px; }
    .header-nav a:hover { text-decoration: underline; }
    .top-news { padding: 12px 48px 0; flex: 1; display: flex; flex-direction: column; }
    .news-title { font-size: 13px; font-weight: 700; letter-spacing: 0.1em; color: #1a1a1a; margin-bottom: 12px; }
    .news-list { list-style: none; }
    .news-list li { font-size: 12px; color: #444; padding: 8px 0; display: flex; gap: 20px; align-items: baseline; }
    .news-date { color: #888; flex-shrink: 0; font-size: 11px; }
    .news-link { color: #1a1a1a; text-decoration: none; }
    .news-link:hover { text-decoration: underline; }
    .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding: 12px; background: #fff; }
    .card { padding: 24px 20px; text-decoration: none; color: #1a1a1a; display: flex; flex-direction: column; gap: 8px; background: #f5f5f5; }
    .card:hover { background: #ebebeb; }
    .card-title { font-size: 16px; font-weight: 700; line-height: 1.4; display: flex; align-items: baseline; gap: 0.5em; flex-wrap: nowrap; }
    .card-arrow { font-size: 13px; color: #888; white-space: nowrap; }
    .card-desc { font-size: 11px; color: #666; line-height: 1.8; }
    @media (max-width: 640px) {
      .top-layout { grid-template-columns: 1fr; }
      .top-image { height: 240px; }
      .top-name { padding: 24px 24px 0; }
      .top-news { padding: 12px 24px 0; }
      .site-title { font-size: 40px; }
      .cards { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>
  <div class="top-layout">
    <div class="top-image">
      <Image src={topImage} alt="山王晶" />
    </div>
    <div class="top-right">
      <div class="top-name">
        <div class="site-title">山　王　晶</div>
        <div class="site-title-en">A K I R A &nbsp;&nbsp; S A N N O</div>
      </div>
      <nav class="header-nav">
        <a href="/about">Profile &amp; Contact</a>
        <a href="#">[EN / JP]</a>
      </nav>
      <div class="top-news">
        <div class="news-title">お知らせ</div>
        <ul class="news-list">
          {news.map(post => (
            <li>
              <span class="news-date">{post.data.date}</span>
              <a href={`/column/${post.id}`} class="news-link">
                My 1000 Favorite Things｜{post.data.num}｜{post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <main class="cards">
    <a href="/column" class="card">
      <div class="card-title">My 1000 Favorite Things <span class="card-arrow">＞＞</span></div>
      <div class="card-desc">私が好きなヒト・コト・モノについての1000のコラム。</div>
    </a>
    <a href="/least" class="card">
      <div class="card-title">My 100 Least Favorite Things <span class="card-arrow">＞＞</span></div>
      <div class="card-desc">私が嫌いなヒト・コト・モノについての100のコラム。</div>
    </a>
    <a href="/music" class="card">
      <div class="card-title">My Music <span class="card-arrow">＞＞</span></div>
      <div class="card-desc">自作の音楽。</div>
    </a>
    <a href="/novels" class="card">
      <div class="card-title">My Novels <span class="card-arrow">＞＞</span></div>
      <div class="card-desc">自作の小説。</div>
    </a>
  </main>
</body>
</html>