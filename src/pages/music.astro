---
import { Image } from 'astro:assets';

import img01 from '../assets/music/001_Tucano.jpg';
import img02 from '../assets/music/002_Siesta.jpg';
import img03 from '../assets/music/003_Tiger.jpg';
import img04 from '../assets/music/004_Domestic.jpg';
import img05 from '../assets/music/005_Le_Feu_follet.jpg';
import img06 from '../assets/music/006_Les_Liaisons_dangereuses.jpg';
import img07 from '../assets/music/007_The_Palm-Wine.jpg';
import img08 from '../assets/music/008_Lee_Morgan.jpg';
import img09 from '../assets/music/009_Idylle.jpg';
import img10 from '../assets/music/010_bombaye.jpg';
import img11 from '../assets/music/011_Flapper.jpg';

const tracks = [
  { num: '001', title: 'トゥッカーノ', titleEn: 'Tucano', desc: 'ソン・クラーヴェ（キューバ発祥のリズム・パターン）。タイトルは愛嬌あるルックスのブラジルの鳥の名前から。', instruments: 'Flute, Piano, Harpsichord, Violoncello, Electric Bass, Agogo, Bongo, Claves, Pandeiro, Triangle', img: img01, url: 'https://youtu.be/2xYX8PYClng' },
  { num: '002', title: 'シェスタ', titleEn: 'Siesta', desc: 'ハバネラ。やはりキューバ起源で、ソン・クラーヴェよりさらに古いラテンのリズム。この曲は中南米よりニーノ・ロータ風。', instruments: 'Flute, Accordion, Harp, Double Bass, Bongo, Conga, Triangle', img: img02, url: 'https://youtu.be/lHJw3dJfDSU' },
  { num: '003', title: 'トラよ、トラよ！', titleEn: 'Tiger! Tiger!', desc: 'クレズマー。酒乱の友人にからまれた夜に降りてきた曲。なのでタイトルは動物でなく、ウィリアム・ブレイクでもアルフレッド・ベスターでもなく、酔っぱらいのこと。', instruments: 'Clarinet in E♭, Piano, Cimbalom, Violin, Violoncello, Electric Bass, Cymbal, Timpani', img: img03, url: 'https://youtu.be/nJ1LHCN0sr4' },
  { num: '004', title: '歌謡曲風に', titleEn: 'In The Style of Japanese Domestic Songs', desc: 'わざわざ銘打たなくとも自作はすべて歌謡曲風ながら、タイトルの通り。ジンタで奏でる『蒲田行進曲』のイメージ。', instruments: 'Piccolo, Clarinet in B♭, Tuba, Accordion, Banjo, Bass drum, Cymbal, Snare drum', img: img04, url: 'https://youtu.be/qY0Pgq7CkDg' },
  { num: '005', title: '鬼火', titleEn: 'Le Feu follet', desc: '20世紀初頭のフランスで流行した遅いワルツ（Valse lente）。ジョセフ・コズマやモリス・ジョベールのような戦前の映画音楽、あるいは中島みゆき風。', instruments: 'Alto Flute, Harp, Violin, Violoncello, Electric Bass', img: img05, url: 'https://youtu.be/tItvbD2rHdA' },
  { num: '006', title: '危険な関係', titleEn: 'Les Liaisons dangereuses', desc: 'ヘンリー・マンシーニ『シャレード』(1963)と大野雄二『犬神家の一族』(1976)を足して3で割ったもの。', instruments: 'Harpsichord, Harp, Strings, Electric Bass, Bongo, Conga, Claves, Crotal, Guiro, Timpani', img: img06, url: 'https://youtu.be/KtwDQ97tJNc' },
  { num: '007', title: 'やし酒飲み', titleEn: 'The Palm-Wine Drinkard', desc: '旋法を使った曲。タイトルはナイジェリアの作家、エイモス・チュツオーラ（Amos Tutuola, 1920–1997）の奇想天外な名作（1946）から。', instruments: 'Flute, Oboe, Bassoon, Harp, Electric Bass, Marimba, Talking drum', img: img07, url: 'https://youtu.be/wVwRDCjmUqI' },
  { num: '008', title: 'リー・モーガンの墓', titleEn: 'Le Tombeau de Lee Morgan', desc: '名盤『Moanin\'』(1958)収録の『Are You Real?』でリー・モーガンの吹く一瞬のアドリブが美しく（2\'22くらいのところ）、それを元にしたバロック・ジャズ。', instruments: 'Flute, Harpsichord, Violoncello, Electric Bass, Vibraphone', img: img08, url: 'https://youtu.be/9vCN9SJ4F0w' },
  { num: '009', title: '牧歌', titleEn: 'Idylle (Emanuel Chabrier)', desc: 'カバー。オリジナルは19世紀フランスの作曲家、エマヌエル・シャブリエ（1841–1894）のピアノ曲集『10の絵画的小品』(1881)中の名作。', instruments: 'Oboe, Bassoon, Accordion, Harp, Electric Bass', img: img09, url: 'https://youtu.be/gRFjzeZBrxE' },
  { num: '010', title: 'ボンバイエ・ワルツ', titleEn: 'La Valse de bom-ba-ye', desc: 'アントニオ猪木『炎のファイター』のテーマによる優雅で感傷的なワルツ。迷わず聴けよ聴けばわかるさ', instruments: 'Piano, Accordion, Violin, Violoncello', img: img10, url: 'https://youtu.be/jUBcKV8hzhs' },
  { num: '011', title: 'フラッパー', titleEn: 'Flapper', desc: 'ブギ・ウギ。タイトルは「Jazz Age」「Roaring Twenties」と謳われた大恐慌時代アメリカの不良少女のこと。デスパレートな跛行リズム。', instruments: 'Flute, Clarinet in B♭, Piano, Violin, Violoncello, Double Bass, Drums', img: img11, url: 'https://youtu.be/qYviG3LQI7U' },
];
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Music | 山王晶</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Noto Sans JP', sans-serif; background: #fff; color: #1a1a1a; }
    .site-nav { max-width: 860px; margin: 0 auto; padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 0.5px solid #ddd; }
    .site-nav a { font-size: 12px; color: #888; text-decoration: none; }
    .site-nav a:hover { color: #1a1a1a; }
    .site-logo { font-family: 'Noto Serif JP', serif; font-size: 14px; font-weight: 400; color: #1a1a1a; text-decoration: none; -webkit-font-smoothing: antialiased; }
    .page-header { max-width: 860px; margin: 0 auto; padding: 28px 24px 16px; }
    .page-title { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
    .page-desc { font-size: 12px; color: #1a1a1a; margin-bottom: 8px; }
    .track-list { max-width: 860px; margin: 0 auto; }
    .track-list-inner { margin: 0 24px; border-top: 0.5px solid #ddd; }
    .track { display: grid; grid-template-columns: 1fr 200px; border-bottom: 0.5px solid #ddd; min-height: 160px; text-decoration: none; color: #1a1a1a; }
    .track:hover { background: #fafafa; }
    .track-inner { padding: 20px 20px 20px 0; }
    .track-num { font-size: 11px; color: #aaa; font-weight: 400; margin-bottom: 4px; }
    .track-title { font-size: 15px; font-weight: 700; line-height: 1.4; margin-bottom: 8px; }
    .track-title-en { font-size: 13px; color: #1a1a1a; font-weight: 400; }
    .track-desc { font-size: 12px; color: #444; line-height: 1.7; font-family: 'Noto Serif JP', serif; margin-bottom: 8px; }
    .track-instruments { font-size: 11px; color: #888; line-height: 1.6; }
    .track-img { overflow: hidden; padding: 8px 0 8px 12px; }
    .track-img img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
    .pagination { max-width: 860px; margin: 0 auto; padding: 24px; display: flex; justify-content: space-between; align-items: center; border-top: 0.5px solid #ddd; }
    .pagination-btn { font-size: 12px; border: 0.5px solid #ccc; padding: 8px 20px; cursor: pointer; background: #fff; color: #555; font-family: 'Noto Sans JP', sans-serif; }
    .pagination-btn:hover:not(:disabled) { background: #f5f5f5; border-color: #999; }
    .pagination-btn:disabled { color: #ccc; border-color: #eee; cursor: default; }
    .pagination-info { font-size: 11px; color: #aaa; }
    @media (max-width: 640px) {
      .site-nav, .page-header, .pagination { padding-left: 16px; padding-right: 16px; }
      .track-list-inner { margin: 0 16px; }
      .track { grid-template-columns: 1fr; min-height: auto; }
      .track-img { height: 160px; padding: 8px 0 0 0; }
    }
  </style>
</head>
<body>
  <nav class="site-nav">
    <a href="/" class="site-logo">山王晶</a>
    <a href="/">← トップへ戻る</a>
  </nav>
  <div class="page-header">
    <div class="page-title">My Music　<span style="font-size:14px; font-weight:400; color:#1a1a1a;">全{tracks.length}曲</span></div>
    <div class="page-desc">自作の音楽。</div>
  </div>
  <div class="track-list" id="track-list">
    <div class="track-list-inner">
      {tracks.map(track => (
        <a href={track.url} target="_blank" rel="noopener noreferrer" class="track">
          <div class="track-inner">
            <div class="track-num">|{track.num}|</div>
            <div class="track-title">{track.title}　<span class="track-title-en">{track.titleEn}</span></div>
            <div class="track-desc">{track.desc}</div>
            <div class="track-instruments">Instruments : {track.instruments}</div>
          </div>
          <div class="track-img">
            <Image src={track.img} alt={track.title} width={200} height={120} />
          </div>
        </a>
      ))}
    </div>
  </div>
  <div class="pagination" id="pagination">
    <button class="pagination-btn" id="prev-btn">← 前のページ</button>
    <span class="pagination-info" id="pagination-info"></span>
    <button class="pagination-btn" id="next-btn">次のページ →</button>
  </div>

  <script>
    const PER_PAGE = 10;
    const tracks = Array.from(document.querySelectorAll('.track'));
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const paginationInfo = document.getElementById('pagination-info');
    let currentPage = 1;

    function renderPage() {
      const total = tracks.length;
      const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
      const start = (currentPage - 1) * PER_PAGE;
      const end = start + PER_PAGE;
      tracks.forEach((track, i) => {
        track.style.display = (i >= start && i < end) ? 'grid' : 'none';
      });
      paginationInfo.textContent = currentPage + ' / ' + totalPages + ' ページ';
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) { currentPage--; renderPage(); }
    });
    nextBtn.addEventListener('click', () => {
      const totalPages = Math.ceil(tracks.length / PER_PAGE);
      if (currentPage < totalPages) { currentPage++; renderPage(); }
    });

    renderPage();
  </script>
</body>
</html>