---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import topImage from '../assets/Sanno-top.jpg';

const allPosts = await getCollection('column');
const news = allPosts
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 5);
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>山王晶</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@400;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Noto Sans JP', sans-serif; background: #fff; color: #1a1a1a; }

    /* ヘッダー */
    .site-header {
      display: grid;
      grid-template-columns: 2fr 3fr;
      height: 360px;
    }
    .header-image {
      overflow: hidden;
    }
    .header-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .header-right {
      background: #fff;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 40px 48px;
    }
    .site-title {
      font-family: 'Noto Serif JP', serif;
      font-size: 64px;
      font-weight: 700;
      letter-spacing: 0.3em;
      line-height: 1;
      color: #1a1a1a;
    }
    .site-title-en {
      font-family: 'Noto Serif JP', serif;
      font-size: 13px;
      letter-spacing: 0.45em;
      margin-top: 12px;
      color: #1a1a1a;
    }
    .header-nav {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-top: 24px;
      padding-top: 24px;
      border-top: 0.5px solid #ddd;
    }
    .header-nav a {
      color: #1a1a1a;
      text-decoration: none;
      font-size: 12px;
    }
    .header-nav a:hover { text-decoration: underline; }
    .sns-icons {
      display: flex;
      gap: 8px;
      margin-left: auto;
    }
    .sns-icons a {
      color: #1a1a1a;
      font-size: 11px;
      text-decoration: none;
      border: 0.5px solid #999;
      padding: 3px 7px;
    }
    .sns-icons a:hover { background: #f5f5f5; }

    /* お知らせ */
    .news {
      max-width: 860px;
      margin: 0 auto;
      padding: 32px 24px 0;
      border-top: 0.5px solid #ddd;
    }
    .news-title {
      font-size: 11px;
      letter-spacing: 0.1em;
      color: #888;
      margin-bottom: 12px;
    }
    .news-list {
      list-style: none;
    }
    .news-list li {
      font-size: 12px;
      color: #444;
      line-height: 1;
      padding: 10px 0;
      border-bottom: 0.5px solid #eee;
      display: flex;
      gap: 20px;
      align-items: baseline;
    }
    .news-date {
      color: #888;
      flex-shrink: 0;
      font-size: 11px;
    }
    .news-link {
      color: #1a1a1a;
      text-decoration: none;
    }
    .news-link:hover { text-decoration: underline; }

    /* カードグリッド */
    .cards {
      max-width: 860px;
      margin: 40px auto;
      padding: 0 24px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      border-top: 0.5px solid #ddd;
      border-left: 0.5px solid #ddd;
    }
    .card {
      border-right: 0.5px solid #ddd;
      border-bottom: 0.5px solid #ddd;
      padding: 24px 20px;
      text-decoration: none;
      color: #1a1a1a;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .card:hover { background: #f9f9f9; }
    .card-title {
      font-size: 13px;
      font-weight: 700;
      line-height: 1.5;
    }
    .card-arrow {
      font-size: 11px;
      color: #888;
    }
    .card-desc {
      font-size: 11px;
      color: #666;
      line-height: 1.8;
      margin-top: auto;
    }

    /* スマホ */
    @media (max-width: 640px) {
      .site-header { grid-template-columns: 1fr; height: auto; }
      .header-image { height: 200px; }
      .header-right { padding: 24px; }
      .site-title { font-size: 36px; }
      .cards { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>

  <header class="site-header">
    <div class="header-image">
      <Image src={topImage} alt="山王晶" />
    </div>
    <div class="header-right">
      <div class="site-title">山　王　晶</div>
      <div class="site-title-en">A K I R A &nbsp;&nbsp; S A N N O</div>
      <nav class="header-nav">
        <a href="/about">[Profile &amp; Contact]</a>
        <a href="#">[EN / JP]</a>
        <div class="sns-icons">
          <a href="#" aria-label="Facebook">F</a>
          <a href="#" aria-label="Instagram">IG</a>
          <a href="#" aria-label="X">X</a>
        </div>
      </nav>
    </div>
  </header>

  <section class="news">
    <div class="news-title">お知らせ</div>
    <ul class="news-list">
      {news.map(post => (
        <li>
          <span class="news-date">{post.data.date}</span>
          <a href={`/column/${post.id}`} class="news-link">
            【My 1000 Favorite Things】【{post.data.num}】{post.data.title}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <main class="cards">
    <a href="/column" class="card">
      <div class="card-title">My 1000 Favorite Things</div>
      <div class="card-arrow">&gt;&gt;</div>
      <div class="card-desc">私が好きなヒト・コト・モノについての1000のコラム。</div>
    </a>
    <a href="/least" class="card">
      <div class="card-title">My 100 Least Favorite Things</div>
      <div class="card-arrow">&gt;&gt;</div>
      <div class="card-desc">私が嫌いなヒト・コト・モノについての100のコラム。</div>
    </a>
    <a href="/music" class="card">
      <div class="card-title">My Music</div>
      <div class="card-arrow">&gt;&gt;</div>
      <div class="card-desc">自作の音楽。</div>
    </a>
    <a href="/novels" class="card">
      <div class="card-title">My Novels</div>
      <div class="card-arrow">&gt;&gt;</div>
      <div class="card-desc">自作の小説。</div>
    </a>
  </main>

</body>
</html>

